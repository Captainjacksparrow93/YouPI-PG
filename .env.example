# YOUPI PG - Environment Configuration Template
# ============================================================
# Copy this file to .env and configure for your deployment.
# NEVER commit .env with real secrets to version control.
# ============================================================

# --- NODE ENVIRONMENT ---
NODE_ENV=development

# --- SERVICE PORTS (Strictly Non-Docker Standard Host Topology) ---
CONTROL_CENTER_PORT=8090
PAYMENT_API_PORT=6100
CHECKOUT_PORTAL_PORT=7000
MERCHANT_ADMIN_PORT=6001
HELP_PORTAL_PORT=3000
GMAIL_OBSERVER_PORT=6003
SMS_OBSERVER_PORT=6002
COIN_WALLET_STORE_PORT=5000

# --- PUBLIC SERVICE URLS ---
BASE_PAYMENT_API_URL=http://localhost:6100
BASE_CHECKOUT_URL=http://localhost:7000
BASE_ADMIN_URL=http://localhost:6001
BASE_HELP_URL=http://localhost:3000
BASE_DEMO_STORE_URL=http://localhost:5000

# --- DATABASE CONFIGURATION ---
# PostgreSQL connection string:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youpi_pg
# SQLite local file fallback for instant zero-dependency testing:
USE_SQLITE_FALLBACK=true
SQLITE_DB_PATH=./data/youpi_pg.sqlite

# --- CRYPTOGRAPHIC SECRETS (Generate using crypto.randomBytes(32).toString('hex')) ---
# Master 256-bit encryption key for sensitive records (OAuth tokens, device keys):
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# Session & JWT secret:
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
# Default Admin credentials for initial setup:
INITIAL_ADMIN_EMAIL=admin@youpi.local
INITIAL_ADMIN_PASSWORD=AdminSecurePassword123!

# --- TIMING & QUEUE ENGINE CONSTANTS ---
# Payment active window (milliseconds, default 5 minutes = 300000):
PAYMENT_ACTIVE_WINDOW_MS=300000
# Payment processing verification window (milliseconds, default 30 seconds = 30000):
PAYMENT_PROCESSING_WINDOW_MS=30000
# Late observation grace evaluation window (milliseconds, default 30 minutes = 1800000):
LATE_OBSERVATION_WINDOW_MS=1800000

# --- GMAIL OBSERVER CONFIGURATION ---
GMAIL_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-client-secret
GMAIL_REDIRECT_URI=http://localhost:6003/oauth/callback
GMAIL_POLL_INTERVAL_MS=5000

# --- SMS / GOOGLE MESSAGES OBSERVER ---
SMS_OBSERVER_POLL_INTERVAL_MS=3000

# --- ANDROID OBSERVER SECURITY ---
# Leave empty to derive a unique secret from YOUPI_ADMIN_TOKEN. Never use a published default.
ANDROID_ENROLLMENT_SECRET=
ANDROID_HEARTBEAT_TIMEOUT_MS=180000

# --- GATEWAY ACCESS CONTROL ---
# Any value left empty is generated once into data/.youpi-secrets.json (chmod 600, git-ignored).
# Read the admin password and merchant secret key from that file after first start.
# Bearer token for /api/v1/admin/* (the merchant admin injects it after login):
YOUPI_ADMIN_TOKEN=
# Bearer token observers use for /api/v1/pollers/events and Gmail credentials:
YOUPI_SERVICE_TOKEN=
# Password for the merchant admin login page:
YOUPI_ADMIN_PASSWORD=
# Default merchant's secret API key for POST /api/v1/payments (server-side only, never in a browser).
# Additional keys: POST /api/v1/admin/api-keys/rotate
YOUPI_MERCHANT_SECRET_KEY=
# Payment simulators / test-mode injection endpoints (can fake payments). Keep false in production.
YOUPI_ENABLE_DEV_TOOLS=false
# Legacy: let browsers create payments with any amount via the public SDK. Keep false in production.
YOUPI_ALLOW_PUBLIC_PAYMENT_CREATE=false
# Control center (process supervisor, no auth) binds to loopback only:
CONTROL_CENTER_HOST=127.0.0.1

# --- SHOPIFY BRIDGE (apps/shopify-bridge, see docs/SHOPIFY_INTEGRATION.md) ---
SHOPIFY_BRIDGE_PORT=6200
SHOPIFY_BRIDGE_URL=https://shopify-bridge.yourdomain.com
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Optional instead of the OAuth install flow:
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_PAYMENT_METHOD_NAME="UPI (YouPI)"
YOUPI_API_URL=http://localhost:6100
# Must equal the webhook secret set in Merchant Admin (webhook URL = <SHOPIFY_BRIDGE_URL>/youpi/webhook):
YOUPI_WEBHOOK_SECRET=

# --- WEBHOOK ENGINE ---
WEBHOOK_MAX_RETRIES=5
WEBHOOK_INITIAL_BACKOFF_MS=5000

# --- WHITE-LABEL BRANDING ---
DEFAULT_APP_NAME="YOUPI PG"
DEFAULT_PRIMARY_COLOR="#2563eb"
DEFAULT_SUPPORT_EMAIL="support@youpi.local"
